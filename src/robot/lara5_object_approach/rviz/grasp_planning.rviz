Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: world
    Background Color: 40; 45; 50
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
      Alpha: 0.25
    - Class: rviz_default_plugins/MarkerArray
      Name: Static grasp preview
      Enabled: true
      Topic:
        Value: /arm/approach/preview/markers
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Planned flange paths
      Enabled: true
      Topic:
        Value: /arm/approach/preview/path_markers
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.45
      Focal Point:
        X: -0.05
        Y: 0.0
        Z: 1.15
      Pitch: 0.45
      Yaw: 0.8
      Target Frame: world
Window Geometry:
  Width: 1100
  Height: 800
